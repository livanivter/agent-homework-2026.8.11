# 复制本文件为 .env 并填入你的 key(--llm 独立模式才需要;默认素材模式不需要)
# 供应商三选一:anthropic(默认)/ openai / deepseek
LLM_PROVIDER=anthropic

# --- 用 Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- 用 OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- 用 DeepSeek(OpenAI 兼容协议,默认模型 deepseek-v4-flash)---
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-dea...

# 可选:指定模型
# LLM_MODEL=deepseek-v4-flash
# 可选:若走网关/代理,覆盖默认地址(默认直连官方 api.deepseek.com)
# DEEPSEEK_BASE_URL=https://你的网关地址
